# Brevo dashboard -> Settings -> SMTP & API -> SMTP tab
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=your-brevo-account-email@example.com
BREVO_SMTP_KEY=your-smtp-key-here

# Default "From" address (must be a verified sender in Brevo)
MAIL_FROM_NAME="RTS Cruises"
MAIL_FROM_EMAIL=your-verified-sender@example.com
